//@version=6
indicator("趋势×周期 v3（EMA20/50 + 牛市支撑带 + 减半周期）", shorttitle="趋势×周期v3", overlay=true, max_lines_count=50)

// ─── ⓪ 颜色与线宽（全部可在设置里改；只影响显示，不影响判断）───
g0 = "⓪ 颜色与线宽"
cE20    = input.color(#FFC107, "EMA20",        group=g0, inline="a")
cE50    = input.color(#E53935, "EMA50",        group=g0, inline="a")
cBand   = input.color(#00A86B, "牛市支撑带",   group=g0, inline="b")
c200    = input.color(#607D8B, "200周SMA",     group=g0, inline="b")
cBull   = input.color(#00A86B, "顺势K",        group=g0, inline="c")
cBear   = input.color(#212121, "逆势K",        group=g0, inline="c")
cRange  = input.color(#9E9E9E, "震荡K",        group=g0, inline="c")
cHalv   = input.color(#5E35B1, "减半竖线",     group=g0, inline="d")
cNext   = input.color(#5E35B1, "下一减半(估)", group=g0, inline="d")
cH19    = input.color(#D32F2F, "H+19 硬清仓线", group=g0, inline="e")
cH34    = input.color(#2E7D32, "H+34 硬买回线", group=g0, inline="e")
cBgArm  = input.color(#E53935, "武装期背景",   group=g0, inline="f")
cBgRe   = input.color(#00A86B, "再入场背景",   group=g0, inline="f")
cBgBear = input.color(#9E9E9E, "熊市等待背景", group=g0, inline="f")
bgT     = input.int(80, "背景透明度（0 实 → 100 透明）", minval=0, maxval=100, group=g0)
lnW     = input.int(2,  "竖线宽度", minval=1, maxval=4, group=g0)

// ─── ① 均线：只保留系统用到的 4 条 ───
g1 = "① 均线"
e20 = ta.ema(close, 20)
e50 = ta.ema(close, 50)
showBand = input.bool(true, "显示牛市支撑带（20周SMA/21周EMA）", group=g1)
show200w = input.bool(false, "显示 200 周 SMA（周期地板）", group=g1)
w20  = request.security(syminfo.tickerid, "W", ta.sma(close, 20))
w21  = request.security(syminfo.tickerid, "W", ta.ema(close, 21))
w200 = request.security(syminfo.tickerid, "W", ta.sma(close, 200))
plot(e20, "EMA20 入场参考", color=cE20, linewidth=1)
plot(e50, "EMA50 失效线",   color=cE50, linewidth=3)
pb1 = plot(showBand ? w20 : na, "20周SMA", color=color.new(cBand, 40), linewidth=1)
pb2 = plot(showBand ? w21 : na, "21周EMA", color=color.new(cBand, 40), linewidth=1)
fill(pb1, pb2, color=color.new(cBand, 88), title="牛市支撑带")
plot(show200w ? w200 : na, "200周SMA", color=c200, linewidth=1, style=plot.style_circles)

// ─── ② 三态变色 K 线（与日报一致）───
g2 = "② 变色K线"
kShow = input.bool(true, "启用", group=g2)
bull = close > e20 and e20 > e50
bear = close < e20 and e20 < e50
kCol = bull ? cBull : bear ? cBear : cRange
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1   // 1D 图；不用 period=="D"，TradingView 可能返回 "1D"
barcolor(kShow and isDaily ? kCol : na, title="三态K线")
float dist = (close - e50) / close * 100      // 距EMA50 % = 单笔风险 %，仓位 = 风险预算% ÷ 它

// ─── ③ 周期层：减半日与阶段 ───
g3 = "③ 减半周期"
showCycle = input.bool(true, "显示减半竖线与阶段背景", group=g3)
showMs    = input.bool(true, "标记 H+19 硬清仓（红点线）/ H+34 硬买回（绿点线）", group=g3)
nextHalv  = input.time(timestamp("2028-04-15 00:00 +0000"), "下一减半（估，每年校正）", group=g3)
var int[] halv = array.from(timestamp("2012-11-28 00:00 +0000"), timestamp("2016-07-09 00:00 +0000"), timestamp("2020-05-11 00:00 +0000"), timestamp("2024-04-20 00:00 +0000"))
MONTH_MS = 86400000.0 * 30.44                 // 月长口径与 daily_check.py 的 cycle() 一致
f_ms(int h, float k) => math.round(h + k * MONTH_MS)
// 最近一次减半（含估算）
f_lastHalv() =>
    int h = na
    for i = 0 to array.size(halv) - 1
        if time >= array.get(halv, i)
            h := array.get(halv, i)
    if time >= nextHalv
        h := nextHalv
    h
int lastH = f_lastHalv()
float mSince = na(lastH) ? na : (time - lastH) / MONTH_MS
string phase = na(mSince) ? "—" : mSince >= 15 and mSince < 20 ? "出场武装期" : mSince >= 20 and mSince < 26 ? "熊市等待期" : mSince >= 26 and mSince < 34 ? "再入场窗口" : "持有累积期"
bool levOK = not na(mSince) and (mSince >= 26 or mSince < 15)   // 合约窗口 [H−22, H+15]，下边界与再入场窗口同步
color phCol = phase == "出场武装期" ? color.new(cBgArm, bgT) : phase == "再入场窗口" ? color.new(cBgRe, bgT) : phase == "熊市等待期" ? color.new(cBgBear, bgT) : na
bgcolor(showCycle ? phCol : na, title="阶段背景")
// 减半竖线 + 硬日期点线
if showCycle
    for i = 0 to array.size(halv) - 1
        int ts = array.get(halv, i)
        if time >= ts and time[1] < ts
            line.new(bar_index, low, bar_index, high, extend=extend.both, color=cHalv, style=line.style_dashed, width=lnW)
        if showMs
            int t19 = f_ms(ts, 19)
            int t34 = f_ms(ts, 34)
            if time >= t19 and time[1] < t19
                line.new(bar_index, low, bar_index, high, extend=extend.both, color=cH19, style=line.style_dotted, width=lnW)
            if time >= t34 and time[1] < t34
                line.new(bar_index, low, bar_index, high, extend=extend.both, color=cH34, style=line.style_dotted, width=lnW)
    if time >= nextHalv and time[1] < nextHalv
        line.new(bar_index, low, bar_index, high, extend=extend.both, color=cNext, style=line.style_dotted, width=lnW)

// ─── ③b 下一里程碑 + 本阶段策略（纯展示；规则原文见 SKILL.md「现货」四段）───
g3b = "③b 策略行"
posLong = input.string("空仓", "当前持仓（只影响「本阶段策略」行）", options=["空仓", "有多仓"], group=g3b) == "有多仓"
string nxtLab = "—"
int nxtTs = na
if not na(mSince)
    if mSince < 15
        nxtLab := "H+15 出场武装"
        nxtTs := f_ms(lastH, 15)
    else if mSince < 19
        nxtLab := "H+19 硬清仓"
        nxtTs := f_ms(lastH, 19)
    else if mSince < 20
        nxtLab := "H+20 进入熊市等待"
        nxtTs := f_ms(lastH, 20)
    else if mSince < 26
        nxtLab := "H+26 再入场+合约窗口开"
        nxtTs := f_ms(lastH, 26)
    else if mSince < 34
        nxtLab := "H+34 硬买回"
        nxtTs := f_ms(lastH, 34)
    else
        nxtLab := "下一减半（估）"
        nxtTs := nextHalv
float daysLeft = na(nxtTs) ? na : (nxtTs - time) / 86400000.0
// ETF 刹车与资金费率图上拿不到，可入场/合约仍以日报为准
bool below = close < e50
string act = "—"
if not na(mSince)
    if posLong
        if phase == "出场武装期"
            act := mSince >= 19 ? "硬清仓剩余（已过 H+19）" : below ? "跌破EMA50→卖1/3（站回再破再卖）" : "持有（已武装：收盘破EMA50卖1/3）"
        else if phase == "熊市等待期"
            act := "清仓（已过硬出场日）"
        else
            act := "持有（周期持有期，破EMA50不卖）"
    else
        if phase == "出场武装期" or phase == "熊市等待期"
            act := "空仓等待（H+26 起可再入场）"
        else if mSince >= 34
            act := "硬买回（已过 H+34，不等顺势）"
        else if not bull
            act := phase == "再入场窗口" ? "等顺势（H+34 仍空仓则硬买回）" : "无操作（未顺势）"
        else
            act := "可入场 1%风险→仓位 " + (dist > 0 ? str.tostring(100 / dist, "#.#") + "%" : "—") + "（需日报 ETF 无刹车）"
color actCol = str.contains(act, "清仓") or str.contains(act, "卖") ? #D32F2F : str.contains(act, "可入场") or str.contains(act, "买回") ? #00A86B : #9E9E9E

// ─── ④ 小表：只放日报要用的数字 ───
g4 = "④ 数据表"
showTbl = input.bool(true, "显示", group=g4)
var table t = table.new(position.top_right, 2, 9, border_width=1, frame_width=1, frame_color=#9E9E9E)
f_cell(int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, bgcolor=#455A64, text_color=#FFFFFF, text_size=size.small)
    table.cell(t, 1, r, v, bgcolor=color.new(c, 75), text_color=#000000, text_size=size.small)
if showTbl and barstate.islast and not isDaily
    table.clear(t, 0, 0, 1, 8)
    table.cell(t, 0, 0, "⚠ 请切到日线（1D）", bgcolor=#D32F2F, text_color=#FFFFFF, text_size=size.normal)
    table.cell(t, 1, 0, "EMA20/50、状态、仓位、策略行只在日线有效；周期背景与竖线不受影响", bgcolor=color.new(#D32F2F, 60), text_color=#000000, text_size=size.small)
if showTbl and barstate.islast and isDaily
    string st = bull ? "顺势" : bear ? "逆势" : "震荡"
    f_cell(0, "状态", st, bull ? #00A86B : bear ? #D32F2F : #9E9E9E)
    f_cell(1, "收盘", str.tostring(close, format.mintick), #FFFFFF)
    f_cell(2, "EMA20", str.tostring(e20, format.mintick), #FFC107)
    f_cell(3, "EMA50 失效", str.tostring(e50, format.mintick), #E53935)
    f_cell(4, "距EMA50", (dist >= 0 ? "+" : "") + str.tostring(dist, "#.#") + "%（1%风险→仓位 " + (dist > 0 ? str.tostring(100 / dist, "#.#") + "%" : "—") + "）", dist >= 0 ? #00A86B : #D32F2F)
    f_cell(5, "周期", na(mSince) ? "—" : "减半后 " + str.tostring(mSince, "#.#") + " 月 · " + phase, phCol)
    f_cell(6, "合约窗口", levOK ? "开放（需顺势+ETF无刹车+费率<20%）" : na(lastH) ? "关闭" : "关闭（" + str.format_time(f_ms(lastH, 26), "yyyy-MM-dd", "UTC") + " 起）", levOK ? #00A86B : #9E9E9E)
    f_cell(7, "下一里程碑", na(nxtTs) ? "—" : nxtLab + " " + str.format_time(nxtTs, "yyyy-MM-dd", "UTC") + "（" + str.tostring(daysLeft, "#") + " 天后）", #FFFFFF)
    f_cell(8, "本阶段策略", act, actCol)

// ─── ⑥ 图例：哪条线 / 哪种背景 / 哪种 K 线颜色 对应什么（左下角，可关）───
g6 = "⑥ 图例"
showLeg = input.bool(true, "显示图例（左下角）", group=g6)
var table lg = table.new(position.bottom_left, 2, 12, border_width=1, frame_width=1, frame_color=#9E9E9E)
f_leg(int r, color c, string glyph, string txt, bool isBg) =>
    if isBg
        table.cell(lg, 0, r, glyph, bgcolor=color.new(c, 60), text_color=#000000, text_size=size.tiny)
    else
        table.cell(lg, 0, r, glyph, bgcolor=#263238, text_color=c, text_size=size.tiny)
    table.cell(lg, 1, r, txt, bgcolor=#455A64, text_color=#FFFFFF, text_size=size.tiny, text_halign=text.align_left)
if showLeg and barstate.islast
    f_leg(0,  cE20,   "———",   "EMA20（日）细线 · 入场参考；价 > EMA20 > EMA50 = 顺势", false)
    f_leg(1,  cE50,   "▬▬▬",   "EMA50（日）粗线 · 失效线；收盘跌破 = 出场触发，只在武装期执行", false)
    f_leg(2,  cBand,  "▒▒▒",   "牛市支撑带 · 20周SMA 与 21周EMA 之间的色带，只作背景参照", false)
    f_leg(3,  c200,   "○○○",   "200周SMA 圆点 · 周期地板，默认关闭，熊市时打开看", false)
    f_leg(4,  cHalv,  "– – –", "减半日 竖虚线 · 已发生 4 次", false)
    f_leg(5,  cNext,  "· · ·", "下一减半（估）竖点线 · 每年月报校正一次", false)
    f_leg(6,  cH19,   "· · ·", "H+19 硬清仓 竖点线 · 武装期内到此日剩余全清", false)
    f_leg(7,  cH34,   "· · ·", "H+34 硬买回 竖点线 · 再入场窗口末仍空仓则买回", false)
    f_leg(8,  cBgArm, "背景",  "出场武装期 H+15–20 · 每次收盘破 EMA50 卖 1/3", true)
    f_leg(9,  cBgRe,  "背景",  "再入场窗口 H+26–34 · 顺势可买；合约窗口同步开放", true)
    f_leg(10, cBgBear,"背景",  "熊市等待期 H+20–26 · 有仓清仓，空仓等 H+26", true)
    f_leg(11, cBull,  "K线",   "K 线颜色：顺势 / 逆势 / 震荡（三色见「⓪ 颜色」）", false)

// ─── ⑤ 警报：只有 3 个 ───
alertcondition(isDaily and bull and not bull[1], "转顺势", "价>EMA20>EMA50：转顺势")
alertcondition(isDaily and bear and not bear[1], "转逆势", "价<EMA20<EMA50：转逆势")
alertcondition(isDaily and ta.crossunder(close, e50), "收盘跌破 EMA50", "收盘跌破 EMA50（仅出场武装期执行）")
